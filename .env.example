# Application
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Laravel API (domain data: tickets, agents, SLA) - NOT owned by this service
LARAVEL_API_URL=http://localhost:8000/api
LARAVEL_API_KEY=
LARAVEL_API_TIMEOUT_MS=10000

# LLM provider (provider-agnostic via @langchain/openai + baseURL)
# openai = OpenAI or any OpenAI-compatible endpoint (Novita, Ollama /v1, etc.)
LLM_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_CLASSIFIER_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# MongoDB (conversation state: threads, messages, memories, runs)
MONGODB_URI=mongodb://localhost:27017/ai-service
MONGODB_DB=ai-service

# Redis (cache + BullMQ)
REDIS_URL=redis://localhost:6379

# Typesense (search / RAG, shared with Laravel)
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=
TYPESENSE_COLLECTION_PREFIX=ai_

# Webhooks
WEBHOOK_VERIFY_TOKEN=
WEBHOOK_SIGNING_SECRET=

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
